TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token
PUBLIC_BASE_URL=https://your-domain.example
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# JSON-escaped Firebase service account JSON; keep private on server only.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
# Comma-separated Telegram numeric user IDs allowed to upload. Set this in production.
BOT_ADMIN_IDS=123456789
PORT=3000
